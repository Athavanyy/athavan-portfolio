# MongoDB Connection String
# Replace with your actual MongoDB Atlas connection string
# Format: mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority
#
# To get your connection string:
# 1. Go to MongoDB Atlas: https://cloud.mongodb.com/
# 2. Click "Connect" on your cluster
# 3. Choose "Connect your application"
# 4. Copy the connection string
# 5. Replace <username> and <password> with your database credentials
# 6. Add /portfolio before the ? to specify the database name
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Server Port (optional, defaults to 3000)
PORT=5000

# JWT Secret (for authentication, if needed)
# Generate a random string for production use
JWT_SECRET=your-secret-key-here
